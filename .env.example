TRANSCRIPTION_PROVIDER=openai
EXPLANATION_PROVIDER=openai

DEEPGRAM_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MIN_REQUEST_SECONDS=6.5
GEMINI_TIMEOUT_SECONDS=4.0
GEMINI_CONTEXT_LINES=8
GEMINI_CONFIDENCE_THRESHOLD=0.67
GEMINI_TERM_COOLDOWN_SECONDS=45
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_SECONDS=0.2

OPENAI_API_KEY=
OPENAI_REALTIME_SESSION_MODEL=gpt-realtime
OPENAI_REALTIME_MODEL=gpt-4o-mini-transcribe
OPENAI_REALTIME_LANGUAGE=es
OPENAI_REALTIME_PROMPT=Escribe transcriptos precisos en espanol mexicano. Conserva palabras coloquiales y spanglish cuando aparezcan.
OPENAI_REALTIME_VAD_THRESHOLD=0.45
OPENAI_REALTIME_PREFIX_PADDING_MS=300
OPENAI_REALTIME_SILENCE_MS=450
OPENAI_REALTIME_CREATE_RESPONSE=false
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_TEXT_TIMEOUT_SECONDS=6.0
OPENAI_MIN_REQUEST_SECONDS=2.5
